  dispatch          WhatsAppDispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  status            WhatsAppDispatchStatus
  httpStatus        Int?
  providerMessageId String?
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime               @default(now())
  completedAt        DateTime?

  @@unique([dispatchId, attemptNumber])
  @@index([dispatchId, startedAt])
}
