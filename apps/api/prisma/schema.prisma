// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  SETUP_PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

model Organization {
  id                      String                  @id @default(uuid())
  name                    String
  slug                    String                  @unique
  logoUrl                 String?
  collapsedLogoUrl        String?
  status                  OrganizationStatus      @default(SETUP_PENDING)
  planTier                PlanTier                @default(STARTER)

  // Seats & Pricing
  allocatedSeats          Int                     @default(1)
  pricePerSeatMonth       Float                   @default(500.0)
  setupFeeAmount          Float                   @default(9999.0)
  setupFeePaid            Boolean                 @default(false)

  // Custom Domain & White-labeling
  customDomain            String?                 @unique
  customDomainVerified    Boolean                 @default(false)
  customDomainSslStatus   String                  @default("PENDING") // PENDING, ACTIVE, FAILED
  customDomainTxtRecord   String?

  // Workspace Profile & Branding Settings
  industry                String?
  website                 String?
  primaryEmail            String?
  primaryPhone            String?
  brandingPrimaryColor    String                  @default("#0D1F3D")
  brandingSecondaryColor  String                  @default("#E20613")
  sidebarLogoHeight       Int                     @default(42)
  showLogoInSidebar       Boolean                 @default(true)
  showLogoInLogin         Boolean                 @default(true)
  addressLine1            String?
  city                    String?
  state                   String?
  country                 String?                 @default("India")
  pincode                 String?

  // Extended Workspace Settings (Localization, Financial, Preferences, Security, Integrations)
  workspaceSettingsJson   Json?

  // Razorpay references
  razorpayCustomerId      String?
  razorpaySubscriptionId  String?

  trialEndsAt             DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?

  // Relations
  memberships             OrganizationMember[]
  invitations             OrganizationInvitation[]
  billingTransactions     BillingTransaction[]
  leads                   Lead[]
  leadImports             LeadImport[]
  projects                Project[]
  teams                   Team[]
  attendanceRecords       AttendanceRecord[]
  leaveRequests           LeaveRequest[]
  payrollRecords          PayrollRecord[]
  auditLogs               AuditLog[]
  portalIntegrations      PortalIntegration[]
  housingIntegrations     HousingIntegration[]
  notificationSettings    NotificationSetting[]
  notifications           Notification[]
  whatsappConfig          OrganizationWhatsAppConfig?
  whatsappDispatches      WhatsAppDispatch[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([status])
  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(SALES_AGENT)
  isOwner        Boolean      @default(false)
  isActive       Boolean      @default(true)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(SALES_AGENT)
  token          String       @unique
  invitedById    String?
  invitedBy      User?        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([token])
}

model BillingTransaction {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  amount            Float
  currency          String       @default("INR")
  type              String       // SETUP_FEE, RECURRING_SEATS, SEAT_UPGRADE
  razorpayPaymentId String?      @unique
  razorpayOrderId   String?
  status            String       // created, captured, failed, refunded
  receiptUrl        String?
  invoiceNumber     String?
  metadata          Json?

  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@index([razorpayPaymentId])
}

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  passwordHash     String
  fullName         String?
  role             Role
  isActive         Boolean @default(true)
  twoFactorEnabled Boolean @default(false)

  lastLoginAt            DateTime?
  avatarStorageKey       String?
  avatarMimeType         String?
  avatarUpdatedAt        DateTime?
  metadata               Json?
  lastPasswordChange     DateTime?
  refreshTokenHash       String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  organizationMemberships    OrganizationMember[]
  invitationsSent            OrganizationInvitation[]     @relation("InvitationSender")

  auditLogs                   AuditLog[]
  mobileAppReleases           MobileAppRelease[]
  employeeProfile             EmployeeProfile?
  attendanceRecords           AttendanceRecord[]
  leaveRequests               LeaveRequest[]
  reviewedLeaves              LeaveRequest[]               @relation("LeaveReviewer")
  payrollRecords              PayrollRecord[]
  payslips                    Payslip[]
  attendanceAudits            AttendanceAudit[]            @relation("AttendanceAuditActor")
  ledTeams                    Team[]                       @relation("TeamLeader")
  teamMemberships             TeamMembership[]             @relation("TeamMembershipUser")
  teamLeaderVisibilityGrants   TeamLeaderVisibilityGrant[]  @relation("TeamLeaderVisibilityLeader")
  teamLeaderUserGrants         TeamLeaderVisibilityGrant[]  @relation("TeamLeaderVisibilityUser")
  teamLeaderVisibilityUpdates  TeamLeaderVisibilityGrant[]  @relation("TeamLeaderVisibilityUpdater")
  leadVisibilityOverrides      LeadVisibilityOverride[]     @relation("LeadVisibilityViewer")
  leadVisibilityTargets        LeadVisibilityOverride[]     @relation("LeadVisibilityTarget")
  leadVisibilityUpdates        LeadVisibilityOverride[]     @relation("LeadVisibilityUpdater")
  mobileDeviceTokens          MobileDeviceToken[]
  whatsappDispatches          WhatsAppDispatch[]             @relation("WhatsAppDispatchRecipient")
  modulePermissions           UserModulePermission[]       @relation("UserModulePermissions")
  permissionUpdates           UserModulePermission[]       @relation("UserModulePermissionUpdater")
  rankingTeamAccesses         UserRankingTeamAccess[]      @relation("UserRankingTeamAccesses")
  rankingTeamAccessUpdates    UserRankingTeamAccess[]      @relation("UserRankingTeamAccessUpdater")
  bookingIncentives           BookingIncentive[]           @relation("BookingIncentiveRecipient")
  commissionTargets           UserCommissionTarget[]       @relation("UserCommissionTargetUser")
  commissionTargetUpdates     UserCommissionTarget[]       @relation("UserCommissionTargetUpdater")
  paymentRecipients           Payment[]                    @relation("PaymentRecipient")
  brokerageRuleUpdates        ProjectBrokerageRule[]       @relation("ProjectBrokerageRuleUpdater")
  incentiveVisibilityUpdates  IncentiveVisibilitySetting[] @relation("IncentiveVisibilityUpdater")
  extraIncentives             BookingExtraIncentive[]      @relation("ExtraIncentiveRecipient")
  extraIncentivesCreated      BookingExtraIncentive[]      @relation("ExtraIncentiveCreator")
  loginOtpChallenges          LoginOtpChallenge[]
  twoFactorRoleSettingUpdates RoleTwoFactorSetting[]       @relation("RoleTwoFactorSettingUpdater")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleTwoFactorSetting {
  id          String   @id @default(uuid())
  role        Role     @unique
  enabled     Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("RoleTwoFactorSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
}

model LoginOtpChallenge {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifierHash   String
  otpHash          String
  passwordVerified Boolean   @default(false)
  expiresAt        DateTime
  usedAt           DateTime?
  attemptCount     Int       @default(0)
  requestIp        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([identifierHash])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  SALES_MANAGER
  TEAM_LEADER
  MANAGER
  SALES_AGENT
  TELECALLER
  MARKETING
  BACKEND
}

enum LeadVisibilityOverrideAccess {
  ALLOW
  BLOCK
}

model AccessTemplate {
  id              String   @id @default(uuid())
  role            Role
  moduleKey       String
  canView         Boolean  @default(false)
  canCreate       Boolean  @default(false)
  canUpdate       Boolean  @default(false)
  canDelete       Boolean  @default(false)
  canPunchIn      Boolean  @default(false)
  canPunchOut     Boolean  @default(false)
  isSystemDefault Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([role, moduleKey])
  @@index([role])
}

model UserModulePermission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserModulePermissions", fields: [userId], references: [id], onDelete: Cascade)
  moduleKey   String
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canPunchIn  Boolean  @default(false)
  canPunchOut Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("UserModulePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
  @@index([moduleKey])
}

model UserRankingTeamAccess {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserRankingTeamAccesses", fields: [userId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?    @relation("UserRankingTeamAccessUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model MobileAppRelease {
  id           String @id @default(uuid())
  versionName  String
  buildNumber  Int
  originalName String
  storageKey   String @unique
  sizeBytes    Int
  sha256       String
  releaseNotes String @default("")
  uploaderId   String
  uploader     User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  publishedAt  DateTime?
  publication  MobileAppPublication?

  @@index([createdAt])
}

model MobileAppPublication {
  id        String @id @default("android")
  releaseId String? @unique
  release   MobileAppRelease? @relation(fields: [releaseId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id])

  action     String // LOGIN_SUCCESS, DOC_UPLOAD, etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model EmployeeProfile {
  id                      String         @id @default(uuid())
  userId                  String         @unique
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode            String         @unique
  designation             String?
  joiningDate             DateTime
  employmentStatus        String         @default("Active")
  phone                   String?
  address                 String?
  reportingToId           String?
  monthlyBasic            Decimal        @default(0)
  justificationMultiplier Decimal        @default(0)
  justificationMode       String         @default("MULTIPLIER")
  justificationAmount     Decimal?
  monthlyAllowances       Decimal        @default(0)
  monthlyDeductions       Decimal        @default(0)
  teamId                  String?
  team                    Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shiftId                 String?
  shift                   ShiftTemplate? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([employmentStatus])
}

model AttendanceRecord {
  id                     String            @id @default(uuid())
  organizationId         String?
  organization           Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               User              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate         DateTime
  status                 String            @default("Present")
  checkInAt              DateTime?
  checkInImageUrl        String?
  checkInImageCapturedAt DateTime?
  checkInLocationAddress String?
  checkInLatitude        Float?
  checkInLongitude       Float?
  checkOutAt             DateTime?
  checkOutImageUrl       String?
  checkOutImageCapturedAt DateTime?
  source                 String            @default("PUNCH")
  shiftId                String?
  shift                  ShiftTemplate?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  isLate                 Boolean           @default(false)
  lateMinutes            Int               @default(0)
  lateSequenceInMonth    Int?
  derivedStatusReason    String?
  note                   String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  audits                 AttendanceAudit[]

  @@unique([employeeId, attendanceDate])
  @@index([organizationId])
  @@index([attendanceDate, status])
}

model ShiftTemplate {
  id                 String             @id @default(uuid())
  name               String             @unique
  startTimeMinutes   Int
  endTimeMinutes     Int
  workingDays        Int[]              @default([1, 2, 3, 4, 5, 6])
  lateGraceMinutes   Int                @default(15)
  lateThresholdCount Int                @default(3)
  latePenaltyStatus  String             @default("Half Day")
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employeeProfiles   EmployeeProfile[]
  attendanceRecords  AttendanceRecord[]
}

model AttendanceAudit {
  id           String           @id @default(uuid())
  attendanceId String
  attendance   AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?            @relation("AttendanceAuditActor", fields: [actorId], references: [id])
  previous     Json?
  current      Json?
  reason       String
  createdAt    DateTime         @default(now())

  @@index([attendanceId, createdAt])
}

model Holiday {
  id          String   @id @default(uuid())
  holidayDate DateTime @unique
  name        String
  description String?
  type        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  days           Decimal
  reason         String
  note           String?
  status         String        @default("Pending")
  reviewerId     String?
  reviewer       User?         @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  reviewerNote   String?
  reviewedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model PayrollRecord {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  status         String        @default("Draft")
  basicSalary    Decimal
  allowances     Decimal   @default(0)
  deductions     Decimal   @default(0)
  payableDays    Decimal
  salaryDivisorDays Decimal @default(30)
  manualOverrideReason String?
  presentDays    Decimal   @default(0)
  paidLeaveDays  Decimal   @default(0)
  unpaidDays     Decimal   @default(0)
  holidayDays    Decimal   @default(0)
  grossPay       Decimal
  netPay         Decimal
  pfAmount       Decimal   @default(0)
  pfOverrideReason String?
  pfUpdatedById  String?
  pfUpdatedAt    DateTime?
  adjustment     Decimal   @default(0)
  adjustmentNote String?
  finalizedAt    DateTime?
  finalizedById  String?
  paidAt         DateTime?
  paidById       String?
  reopenedAt     DateTime?
  reopenedById   String?
  reopenReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payslip        Payslip?

  @@unique([employeeId, year, month])
  @@index([organizationId])
  @@index([year, month, status])
}

model Payslip {
  id             String        @id @default(uuid())
  payrollId      String        @unique
  payroll        PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  snapshot       Json
  fileName       String?
  fileUrl        String?
  deliveryStatus String        @default("PENDING")
  sentAt         DateTime?
  generatedAt    DateTime      @default(now())

  @@index([employeeId, generatedAt])
}

model Team {
  id                 String                  @id @default(uuid())
  organizationId     String?
  organization       Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String                  @unique
  description        String?
  leaderId           String?
  leader             User?                   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members            EmployeeProfile[]
  memberships        TeamMembership[]
  visibilityGrants   TeamLeaderVisibilityGrant[] @relation("TeamLeaderVisibilityTeam")
  rankingAccessUsers UserRankingTeamAccess[]
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([organizationId])
  @@index([leaderId])
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TeamMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([userId, isPrimary])
}

model TeamLeaderVisibilityGrant {
  id           String   @id @default(uuid())
  leaderUserId String
  leader       User     @relation("TeamLeaderVisibilityLeader", fields: [leaderUserId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?    @relation("TeamLeaderVisibilityTeam", fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation("TeamLeaderVisibilityUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedById  String?
  updatedBy    User?    @relation("TeamLeaderVisibilityUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leaderUserId])
  @@index([teamId])
  @@index([userId])
}

model LeadVisibilityOverride {
  id           String                       @id @default(uuid())
  viewerUserId String
  viewer       User                         @relation("LeadVisibilityViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User                         @relation("LeadVisibilityTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  accessType   LeadVisibilityOverrideAccess
  updatedById  String?
  updatedBy    User?                        @relation("LeadVisibilityUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  reason       String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([viewerUserId, targetUserId])
  @@index([viewerUserId])
  @@index([targetUserId])
  @@index([accessType])
}

model TeamOld {
  id        String   @id @default(uuid())
  name      String
  type      String?
  location  String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadMasterCategory {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
  sortOrder   Int               @default(0)
  values      LeadMasterValue[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model LeadMasterValue {
  id                          String             @id @default(uuid())
  categoryId                  String
  categoryRef                 LeadMasterCategory @relation(fields: [categoryId], references: [id])
  name                        String
  code                        String
  description                 String?
  group                       String?
  type                        String?
  statusType                  String             @default("Custom")
  isActive                    Boolean            @default(true)
  isSystemDefault             Boolean            @default(false)
  sortOrder                   Int                @default(0)
  defaultNextValueId          String?
  probability                 Int?
  weight                      Int?
  manualScore                 Int?
  pointsEnabled               Boolean            @default(true)
  channel                     String?
  reasonCategory              String?
  displayColor                String?
  tagColor                    String?
  ratingValue                 Int?
  expectedTime                Int?
  expectedTimeUnit            String?
  icon                        String?
  triggerAction               String             @default("NONE")
  allowFollowUp               Boolean            @default(true)
  followUpNotificationEnabled Boolean            @default(true)
  followUpRenotifyMinutes     Int?
  autoAssignActive            Boolean            @default(true)
  showInStatsCard             Boolean            @default(true)
  showInFilterBar             Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@unique([categoryId, code])
  @@index([categoryId, isActive])
}

model Lead {
  id                   String                @id @default(uuid())
  organizationId       String?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayId            String                @unique
  name                 String
  email                String?
  mobileCountryCode    String                @default("+91")
  mobile               String
  alternateCountryCode String?
  alternateMobile      String?
  dateOfBirth          DateTime?
  gender               String?
  sourceId             String?
  campaignId           String?
  stageId              String?
  statusId             String?
  priorityId           String?
  temperatureId        String?
  ratingId             String?
  interestLevel        String?
  heardAboutUs         String?
  remarks              String?
  referenceBy          String?
  ownerId              String?
  managerId            String?
  telecallerId         String?
  fieldExecutiveId     String?
  createdById          String?
  assignedAt           DateTime?
  lastContactedAt      DateTime?
  nextFollowUpAt       DateTime?
  lostReasonId         String?
  lostCompetitor       String?
  lostAt               DateTime?
  convertedAt          DateTime?
  deletedAt            DateTime?
  deletedById          String?
  deleteReason         String?
  isDuplicate          Boolean               @default(false)
  requirement          LeadRequirement?
  assignments          LeadAssignment[]
  followUps            FollowUp[]
  activities           Activity[]
  tasks                Task[]
  notes                Note[]
  documents            Document[]
  siteVisits           SiteVisit[]
  bookings             Booking[]
  payments             Payment[]
  callLogs             CallLog[]
  projectInterests     LeadProjectInterest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId])
  @@index([mobile])
  @@index([email])
  @@index([stageId])
  @@index([statusId])
  @@index([sourceId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model LeadRequirement {
  leadId             String   @id
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyType       String?
  configuration      String?
  budgetRange        String?
  minBudget          Decimal?
  maxBudget          Decimal?
  budgetUnit         String?
  preferredLocation  String?
  preferredProjectId String?
  possessionTimeline String?
  carpetAreaRange    String?
  purpose            String?
  minArea            Decimal?
  maxArea            Decimal?
  zone               String?
  occupation         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LeadProjectInterest {
  id           String       @id @default(uuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         ProjectUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  isPrimary    Boolean      @default(false)
  matchPercent Int?
